# Copiar a .env (ignorado por git) y completar. Nunca versionar el .env real.
# Para generar cada contraseña: openssl rand -hex 24

MYSQL_ROOT_PASSWORD=

# Una contraseña por base: cada servicio solo conoce la suya
EVENTOS_SEGURIDAD_DB_PASSWORD=
EVENTOS_EVENTOS_DB_PASSWORD=
EVENTOS_PAGOS_DB_PASSWORD=

# Puerto de la máquina donde se publica el sitio
SARAO_PUERTO=80
