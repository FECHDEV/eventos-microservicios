# Copiar a .env (ignorado por git) y completar. Nunca versionar el .env real.
# Para generar cada contraseña: openssl rand -hex 24

MYSQL_ROOT_PASSWORD=

# Una contraseña por base: cada servicio solo conoce la suya
EVENTOS_SEGURIDAD_DB_PASSWORD=
EVENTOS_EVENTOS_DB_PASSWORD=
EVENTOS_PAGOS_DB_PASSWORD=

# Clave de los tokens de sesión: base64 de al menos 256 bits. Solo la usa Seguridad.
#   openssl rand -base64 48
EVENTOS_JWT_SECRETO=

# Clave con la que los servicios confían entre sí
EVENTOS_CLAVE_SERVICIO=

# Administrador inicial: se crea en el primer arranque, si no hay ninguno. La
# contraseña sigue la regla del registro. Después se puede borrar de acá
EVENTOS_ADMIN_CORREO=
EVENTOS_ADMIN_PASSWORD=

# Correo: simulador por defecto. Con smtp, levantar con --profile correo y crear los
# buzones. Vacíos usan simulador, mail.com y http://localhost
EVENTOS_CORREO_PROVEEDOR=
EVENTOS_CORREO_DOMINIO=
EVENTOS_SITIO_URL=
# Solo en esta máquina. Vacío usa 8025
SARAO_WEBMAIL_PUERTO=

# Sistema de pago, obligatorio: simulador (con botones de prueba en la pantalla,
# nunca en el servidor) o libelula. Con libelula, la appkey y el correo de la empresa con que se registran
# las deudas; sin ellos Pagos no arranca. Libélula avisa los pagos a
# EVENTOS_SITIO_URL/api/pagos/aviso: solo llega si el sitio es público.
# Cada prueba con libelula cobra dinero real
EVENTOS_PAGO_PROVEEDOR=
EVENTOS_PAGO_LIBELULA_APPKEY=
EVENTOS_PAGO_LIBELULA_EMAIL=

# Puerto de la máquina donde se publica el sitio
SARAO_PUERTO=80

# Solo en el servidor, con docker-compose.nube.yml: el dominio con que Caddy pide el
# certificado HTTPS. Uno propio o la IP en sslip.io (1-2-3-4.sslip.io)
SARAO_DOMINIO=
